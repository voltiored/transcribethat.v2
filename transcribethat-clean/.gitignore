# ──────────────────────────────────────────────────────────────────────
#  TranscribeThat — .gitignore para repo limpio en GitHub
# ──────────────────────────────────────────────────────────────────────

# Carpetas de la plantilla Emergent (no usadas por TranscribeThat)
backend/
frontend/
tests/
test_reports/
memory/
test_result.md
yarn.lock

# Plataforma Emergent (interno)
.emergent/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.eggs/
*.egg-info/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Sistema
.DS_Store
Thumbs.db
*.log

# Streamlit caché local (modelos faster-whisper se descargan en runtime)
.streamlit/secrets.toml

# Variables de entorno con keys (NUNCA subir keys)
.env
.env.*
*.env
!.env.example

# Archivos temporales / cachés
*.tmp
*.cache
.cache/

# Archivos que faster-whisper descarga (no los subas a git, pesan mucho)
*.bin
*.onnx
~/.cache/huggingface/

# Outputs locales generados al probar
output_*.mp4
preview_*.jpg
*.ass
filtro.txt
